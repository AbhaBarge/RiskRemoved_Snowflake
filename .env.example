# ===========================================================================
# .env.example -- copy to .env and fill in.  .env is gitignored.
# ===========================================================================
# This file holds POINTERS and non-secret settings only.
#
# Actual secret VALUES belong in one of:
#   * ~/.snowflake/connections.toml      (Snowflake credentials)
#   * `cortex secret store <key>`        (local CLI secret store)
#   * a Snowflake SECRET object          (anything called from inside Snowflake)
#
# Never put a token in this file, even locally: it is one `git add -f` away
# from being committed.
# ===========================================================================

# --- Which config profile to activate: dev | demo -------------------------
RC_PROFILE=dev

# --- Snowflake -------------------------------------------------------------
# Connection name in ~/.snowflake/connections.toml. Overrides
# conf/external.yml:snowflake.connection_name.
RC_SNOWFLAKE_CONNECTION=ASHWINRAVI004

# Key-pair auth. REQUIRED for unattended runs (automations, CI); interactive
# SSO is acceptable for local development only.
# RC_SNOWFLAKE_PRIVATE_KEY_PATH=C:\Users\you\.snowflake\rsa_key.p8

# Topology overrides. Leave unset to use conf/base.yml + the active profile.
# Useful for pointing a throwaway branch at its own database.
# RC_DATABASE=RISK_COPILOT_SCRATCH
# RC_WAREHOUSE=RC_DEV_WH
# RC_ROLE=RC_ADMIN

# --- Generation ------------------------------------------------------------
# Overrides conf/generation.yml:seed. Change only to produce a deliberately
# different dataset; the default keeps runs reproducible.
# RC_SEED=20260922

# --- Jira (MCP, disabled by default) --------------------------------------
# Token goes in the secret store:  cortex secret store rc_jira_api_token
# RC_JIRA_BASE_URL=https://your-org.atlassian.net
# RC_JIRA_PROJECT_KEY=AML
# RC_JIRA_USER_EMAIL=you@your-org.com

# --- Slack (MCP, disabled by default) ------------------------------------
# Token goes in the secret store:  cortex secret store rc_slack_bot_token
# RC_SLACK_CHANNEL_FRAUD_OPS=#fraud-ops
# RC_SLACK_CHANNEL_COMPLIANCE=#compliance-queue
# RC_SLACK_CHANNEL_PRINCIPAL_OFFICER=#principal-officer

# --- Logging ---------------------------------------------------------------
RC_LOG_LEVEL=INFO
